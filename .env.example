# ------------------------------------------------------------------
# EmailWriterAI.co.uk — environment variable template.
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real API keys to Git.
# Keys are read server-side only (Edge Function), never shipped to the browser.
# ------------------------------------------------------------------

# --- AI providers (server-side only) ---
# Zhipu BigModel (preferred). OpenAI-compatible endpoint.
# Get your API key from https://open.bigmodel.cn/ console (format: {id}.{secret}).
TRAE_API_KEY=your_zhipu_api_key_here
# OpenAI-compatible chat completions base URL.
TRAE_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Preferred model (free, 200K context, but 1-concurrent limit — may 429).
TRAE_MODEL=glm-4.7-flash
# Fallback model (free, more reliable) — used when the preferred model is overloaded.
TRAE_FALLBACK_MODEL=glm-4-flash-250414

# OpenAI fallback (GPT-4o-mini).
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Vercel KV (rate limiting) ---
# Official @vercel/kv variable names (set automatically when you connect KV in Vercel).
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=your_kv_token
# Aliases from the tech spec are also supported by src/lib/kv/client.ts:
# VERCEL_KV_URL=
# VERCEL_KV_TOKEN=

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SITE_URL=https://emailwriterai.co.uk
# Optional: CookieYes site code. When set, the CookieYes banner is loaded instead of
# the built-in lightweight consent banner.
NEXT_PUBLIC_COOKIEYES_SITE_CODE=

# --- AI tuning (optional) ---
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=10000
